TOMTOM_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# Live traffic cost controls. Defaults intentionally leave headroom below the
# current Matrix Routing free allowance.
TOMTOM_LIVE_CACHE_TTL_SECONDS=600
TOMTOM_MIN_REFRESH_SECONDS=60
TOMTOM_MAX_LIVE_REQUESTS_PER_HOUR=5
TOMTOM_MAX_LIVE_REQUESTS_PER_DAY=20
TOMTOM_MONTHLY_TRANSACTION_BUDGET=2000
TOMTOM_MAX_LOCATIONS=100

# The frontend reads these from vrp-dashboard/.env.local.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Keep the stable OSM raster basemap by default. Set to true only when testing
# the OpenFreeMap vector style and its remote tile/font resources.
# NEXT_PUBLIC_ENABLE_VECTOR_BASEMAP=false
